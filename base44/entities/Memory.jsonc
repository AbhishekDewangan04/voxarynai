{
  "name": "Memory",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "contact_number": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "fact": {
      "type": "string"
    },
    "source_call_id": {
      "type": "string"
    }
  },
  "required": [
    "agent_id",
    "fact"
  ],
  "rls": {
    "create": {
      "data.owner_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}