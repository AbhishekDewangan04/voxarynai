{
  "name": "Call",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "caller_name": {
      "type": "string"
    },
    "caller_number": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number",
      "default": 0
    },
    "sentiment": {
      "type": "string",
      "enum": [
        "Positive",
        "Neutral",
        "Negative",
        "Blocked"
      ],
      "default": "Neutral"
    },
    "status": {
      "type": "string",
      "enum": [
        "live",
        "completed",
        "missed",
        "blocked"
      ],
      "default": "live"
    },
    "started_at": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    }
  },
  "required": [
    "agent_id"
  ],
  "rls": {
    "create": {
      "data.owner_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}