{
  "name": "Integration",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "google_calendar",
        "outlook",
        "notion",
        "slack",
        "hubspot",
        "zapier",
        "mongodb",
        "webhook",
        "twilio",
        "whatsapp"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "error"
      ],
      "default": "disconnected"
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "provider"
  ],
  "rls": {
    "create": {
      "data.owner_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}