{
  "name": "Task",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "call_id": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "booking",
        "sms",
        "info_collected",
        "notification"
      ],
      "default": "info_collected"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "done",
        "pending",
        "failed"
      ],
      "default": "pending"
    }
  },
  "required": [
    "description"
  ],
  "rls": {
    "create": {
      "data.owner_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}